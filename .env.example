# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. .env.local 은 git에 올라가지 않는다.
# 값은 Supabase 대시보드 > Project Settings > API 에서 확인한다.

# 화면(브라우저)에서도 쓰는 공개 값
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 비밀키. 화면 코드에 넣지 말고, 이름 앞에 NEXT_PUBLIC_ 을 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 회원제(SNS 로그인) 스위치. "true" 일 때만 켠다. 비워 두면(또는 다른 값이면) 꺼져서 지금 알파와 똑같다 (결정 0061).
# 서버 변수이고 요청 때 읽는다. 비밀은 아니지만 Vercel 에는 사용자가 직접 넣는다. 설정 순서는 docs/SOCIAL_LOGIN.md.
MEMBERS_ENABLED=

# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. .env.local 은 git에 올라가지 않는다.
# 값은 Supabase 대시보드 > Project Settings > API 에서 확인한다.

# 화면(브라우저)에서도 쓰는 공개 값
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 비밀키. 화면 코드에 넣지 말고, 이름 앞에 NEXT_PUBLIC_ 을 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 회원제(SNS 로그인) 스위치. "true" 일 때만 켠다. 비워 두면(또는 다른 값이면) 꺼져서 지금 알파와 똑같다 (결정 0061).
# 서버 변수이고 요청 때 읽는다. 비밀은 아니지만 Vercel 에는 사용자가 직접 넣는다. 설정 순서는 docs/SOCIAL_LOGIN.md.
MEMBERS_ENABLED=

# 네이버 로그인 스위치(이슈 #189, 결정 0064). "true" 일 때만 켠다. 비워 두면(또는 다른 값이면) 로그인 시트의 네이버 버튼은 "준비 중"이고 서버도 네이버 로그인 시작을 막는다(400).
# Supabase 대시보드의 네이버(사용자 지정) 공급자 설정을 마친 뒤에 켠다. 서버 변수이고 요청 때 읽으므로 값만 바꾸고 다시 배포하면 된다(다시 빌드 안 함). 회원제 스위치(MEMBERS_ENABLED)가 꺼져 있으면 의미 없다.
NAVER_LOGIN_ENABLED=
